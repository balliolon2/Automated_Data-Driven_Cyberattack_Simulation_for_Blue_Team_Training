# Environment Configuration Template for SOC Trainer
# =======================================================
# Recommended: Run ./install.sh (Linux/macOS) or install.bat / .\install.ps1 (Windows)
# to generate secure random secrets and configure Local or Cloud mode automatically.
# Manual fallback: cp .env.example .env and populate POSTGRES_PASSWORD and JWT_SECRET.
# Compose refuses to start until POSTGRES_PASSWORD and JWT_SECRET are set.

# Database Settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=cyber_sim

# Security & Authentication (REQUIRED — auto-generated by installers)
JWT_SECRET=

# Initial Administrator Provisioning (recommended — synced on backend startup)
ADMIN_EMAIL=admin@soc.local
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin

# Runtime & Deployment Settings
APP_ENVIRONMENT=local
GIN_MODE=release
# Keep Swagger disabled in deployments; set to "true" only for local API exploration.
ENABLE_SWAGGER=false
BYPASS_POST_TEST_THRESHOLD=false
BYPASS_THEORY_GATE=false
# Comma-free single origin used for CORS in addition to localhost defaults (e.g. https://soc.example.com).
FRONTEND_URL=http://localhost

# Cloud Auto-HTTPS Overlay (populated automatically by --mode cloud with --domain)
DOMAIN=
ACME_EMAIL=
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml

# pgAdmin (optional, only started with: docker compose --profile tools up -d)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=

# AI & LLM Scenario Generation Configuration
# Leave LLM_API_KEY empty to use the pre-seeded static scenario pool.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Research & Evaluation Protocols
PROFICIENCY_THRESHOLD=70.0
MAX_SCENARIOS_CAP=10
SIMULATION_TIME_LIMIT_MINS=120
