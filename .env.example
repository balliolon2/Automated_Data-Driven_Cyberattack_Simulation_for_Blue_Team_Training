# Environment Configuration Template for SOC Trainer
# =======================================================
# Copy this file to `.env` (`cp .env.example .env`) and set strong, unique values.
# Compose refuses to start until POSTGRES_PASSWORD and JWT_SECRET are set.
# PGADMIN_DEFAULT_PASSWORD is only needed when starting the opt-in `tools` profile.
# Generate secrets with: openssl rand -hex 32

# Database Settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=cyber_sim

# Security & Authentication (REQUIRED)
JWT_SECRET=

# Initial Administrator Provisioning (Optional but recommended: creates the admin account on first launch)
ADMIN_EMAIL=admin@soc.local
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin

# Server Settings
GIN_MODE=release
# Keep Swagger disabled in deployments; set to "true" only for local API exploration.
ENABLE_SWAGGER=false
BYPASS_POST_TEST_THRESHOLD=false
# Comma-free single origin used for CORS in addition to localhost defaults.
FRONTEND_URL=http://localhost

# pgAdmin (optional, only started with: docker compose --profile tools up -d)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=

# AI & LLM Scenario Generation Configuration
# Leave LLM_API_KEY empty to use the pre-seeded static scenario pool.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Research & Evaluation Protocols
PROFICIENCY_THRESHOLD=70.0
MAX_SCENARIOS_CAP=10
SIMULATION_TIME_LIMIT_MINS=120
