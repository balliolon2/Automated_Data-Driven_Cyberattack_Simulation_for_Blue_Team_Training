# Environment Configuration Template for SOC Trainer
# =======================================================

# Database Settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=cyber_sim

# Security & Authentication
JWT_SECRET=replace_with_a_secure_cryptographic_random_string_in_production

# Initial Administrator Provisioning (Required on first launch to create the admin account)
ADMIN_EMAIL=admin@soc.local
ADMIN_PASSWORD=change_me_to_a_secure_admin_password
ADMIN_NICKNAME=admin

# Server Settings
GIN_MODE=release
DEPLOYMENT_MODE=local

# AI & LLM Scenario Generation Configuration
# Options for LLM_MODE: 'static' (uses pre-seeded scenarios) or 'llm' (real-time generation)
LLM_MODE=static
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Research & Evaluation Protocols
PROFICIENCY_THRESHOLD=70.0
MAX_SCENARIOS_CAP=10
SIMULATION_TIME_LIMIT_MINS=120
