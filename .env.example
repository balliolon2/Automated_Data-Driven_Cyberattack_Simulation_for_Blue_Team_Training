# ============================================================
#  SOC Trainer – Environment Variables
#  Copy this file to .env and fill in the values.
#     cp .env.example .env
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=cyber_sim

# ---------- pgAdmin ----------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=password

# Connection string used by the Go backend and Python scripts.
# Must match the credentials in docker-compose.yml.
DATABASE_URL=host=localhost user=admin password=password dbname=cyber_sim port=5432 sslmode=disable TimeZone=Asia/Bangkok

# ---------- JWT ----------
# Secret key used to sign and verify JSON Web Tokens.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-value

# ---------- Go / Gin ----------
# Set to "release" for production, "debug" for development.
GIN_MODE=debug

# ---------- OpenAI-Compatible LLM Integration ----------
# OpenAI SDK Compatible API settings (e.g. OpenAI, OpenRouter, Groq, DeepSeek, LocalAI, Ollama, vLLM)
# If LLM_API_KEY is left empty, the platform automatically uses static seed scenarios.
LLM_API_KEY=sk-your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

