    "definitions": {
        "dto.ActiveSimulationResponse": {
            "type": "object",
            "properties": {
                "actions": {},
                "scenario": {
                    "$ref": "#/definitions/dto.ScenarioResponse"
                },
                "session": {}
            }
        },
        "dto.AuthResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "analyst@soc.local"
                },
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
            }
        },
        "dto.DetailedExamResultDTO": {
            "type": "object",
            "properties": {
                "correct_answer": {
                    "type": "string",
                    "example": "A"
                },
                "domain_id": {
                    "type": "string",
                    "example": "domain1"
                },
                "explanation": {
                    "type": "string",
                    "example": "Digital signatures ensure non-repudiation."
                },
                "is_correct": {
                    "type": "boolean",
                    "example": true
                },
                "options": {},
                "question_id": {
                    "type": "string",
                    "example": "d1-q01"
                },
                "question_text": {
                    "type": "string",
                    "example": "Which security control provides non-repudiation?"
                },
                "type": {
                    "type": "string",
                    "example": "multiple_choice"
                },
                "user_answer": {
                    "type": "string",
                    "example": "A"
                }
            }
        },
        "dto.DomainScoreDTO": {
            "type": "object",
            "properties": {
                "correct_count": {
                    "type": "integer",
                    "example": 3
                },
                "domain_id": {
                    "type": "string",
                    "example": "domain1"
                },
                "percentage": {
                    "type": "number",
                    "example": 75
                },
                "total_count": {
                    "type": "integer",
                    "example": 4
                }
            }
        },
        "dto.DomainStatusDTO": {
            "type": "object",
            "properties": {
                "domain_id": {
                    "type": "string",
                    "example": "domain1"
                },
                "domain_name": {
                    "type": "string",
                    "example": "General Security Concepts"
                },
                "passed": {
                    "type": "boolean",
                    "example": true
                },
                "proficiency_score": {
                    "type": "number",
                    "example": 75.5
                },
                "threshold": {
                    "type": "number",
                    "example": 70
                }
            }
        },
        "dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "BAD_REQUEST"
                },
                "error": {
                    "type": "string",
                    "example": "Invalid request payload"
                },
                "message": {
                    "type": "string",
                    "example": "Detailed error description"
                }
            }
        },
        "dto.ExamSessionResponse": {
            "type": "object",
            "properties": {
                "questions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.QuestionDTO"
                    }
                },
                "session": {}
            }
        },
        "dto.LogQueryRequest": {
            "type": "object",
            "required": [
                "query",
                "session_id"
            ],
            "properties": {
                "query": {
                    "type": "string",
                    "example": "DeviceName == 'Chiller-01'"
                },
                "session_id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                }
            }
        },
        "dto.LogQueryResponse": {
            "type": "object",
            "properties": {
                "action_id": {
                    "type": "integer",
                    "example": 42
                },
                "recorded": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "analyst@soc.local"
                },
                "password": {
                    "type": "string",
                    "example": "Secret123!"
                }
            }
        },
        "dto.MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Operation completed successfully"
                }
            }
        },
        "dto.QuestionDTO": {
            "type": "object",
            "properties": {
                "domain_id": {
                    "type": "string",
                    "example": "domain1"
                },
                "options": {},
                "order_index": {
                    "type": "integer",
                    "example": 1
                },
                "question_id": {
                    "type": "string",
                    "example": "d1-q01"
                },
                "question_text": {
                    "type": "string",
                    "example": "Which security control provides non-repudiation?"
                },
                "type": {
                    "type": "string",
                    "example": "multiple_choice"
                },
                "user_answer": {
                    "type": "string",
                    "example": "A"
                }
            }
        },
        "dto.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "analyst@soc.local"
                },
                "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "Secret123!"
                }
            }
        },
        "dto.ResearchSummaryResponse": {
            "type": "object",
            "properties": {
                "all_domains_passed": {
                    "type": "boolean",
                    "example": true
                },
                "average_proficiency": {
                    "type": "number",
                    "example": 78.5
                },
                "calculation_version": {
                    "type": "string",
                    "example": "v1.0-weighted-0.4-0.6"
                },
                "completed_scenarios": {
                    "type": "integer",
                    "example": 3
                },
                "domain_profiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.DomainStatusDTO"
                    }
                },
                "eligible_for_post": {
                    "type": "boolean",
                    "example": true
                },
                "has_post_test": {
                    "type": "boolean",
                    "example": true
                },
                "has_pre_test": {
                    "type": "boolean",
                    "example": true
                },
                "improvement_score": {
                    "type": "number",
                    "example": 20
                },
                "max_scenarios": {
                    "type": "integer",
                    "example": 10
                },
                "participant_id": {},
                "post_test_score": {
                    "type": "number",
                    "example": 85
                },
                "pre_test_score": {
                    "type": "number",
                    "example": 65
                },
                "protocol_version": {
                    "type": "string",
                    "example": "protocol-v1"
                },
                "rubric_version": {
                    "type": "string",
                    "example": "v1.0-20-40-40"
                },
                "total_actions": {
                    "type": "integer",
                    "example": 18
                },
                "total_elapsed_sec": {
                    "type": "integer",
                    "example": 720
                }
            }
        },
